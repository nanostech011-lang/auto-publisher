# ==============================================================================
# AutoPublisher Pro - Configuracoes de Seguranca e Integridade do PNPM
# ==============================================================================

# 1. Integridade e Imutabilidade
verify-store-integrity=true
lockfile=true
prefer-frozen-lockfile=true

# 2. Isolamento Estrito de Dependencias (Prevencao de Supply Chain / Phantom Dependencies)
node-linker=isolated
shamefully-hoist=false
auto-install-peers=true
strict-peer-dependencies=false

# 3. Restricao Estrita de Versoes de Runtime (Node.js e PNPM)
engine-strict=true

# 4. Auditoria de Seguranca e Vulnerabilidades
audit=true
audit-level=high
fund=false

# 5. Registro Oficial e Seguro
registry=https://registry.npmjs.org/
always-auth=false
