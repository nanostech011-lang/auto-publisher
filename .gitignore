# ==============================================================================
# AutoPublisher Pro - Git Ignore Rules
# ==============================================================================

# Credenciais e Variáveis de Ambiente
.env
.env.local
*.json
!skills.json
!plugins.json
!mcp_config.json
!pipeline/**/*.json
credentials.json
client_secret*.json
service-account*.json
*.pem
*.key

# Build e Compilação
target/
/build/
/out/
/bin/
*.class
*.jar
!.mvn/wrapper/maven-wrapper.jar
*.war

# IDEs e Editores
.idea/
*.iml
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db

# Logs & Temporários
logs/
*.log
*.tmp
*.bak
*.orig

# Maven & Gradle
.mvn/timing.properties
.gradle/

# Node & Package Managers (Estrito para pnpm)
node_modules/
package-lock.json
!pnpm-lock.yaml
!pnpm-workspace.yaml

# Testes Playwright & Dumps Efêmeros
test-results/
playwright-report/
blob-report/
playwright/.cache/
docs/manual/manual_screenshot.png
docs/manual/test_run/
.playwright-mcp/

# Pipeline & Renderização de Mídia (Zero-Copy)
# Bloqueio de mídias geradas e scratch temporário
pipeline/scratch/**/*
pipeline/output/**/*
pipeline/.cache/
pipeline/state/*
!pipeline/state/.gitkeep
!pipeline/scratch/.gitkeep
!pipeline/output/.gitkeep
!pipeline/assets/fonts/.gitkeep
!pipeline/assets/music/.gitkeep

# Bloqueio geral de vídeos binários pesados
*.mp4
*.mkv
*.avi
*.mov

# Migrações antigas
.github/modernize/

# Agent platform skills locais
.agents/skills/*
!.agents/skills/autopublisher-dev-workflow/
!.agents/skills/sheets-contract-validator/
!.agents/skills/youtube-oauth-setup/
