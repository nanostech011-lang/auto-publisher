{
  "name": "autopublisher",
  "version": "1.0.0",
  "type": "module",
  "description": "> Microsserviço backend serverless em **Java 21** e **Spring Boot 3** para automação e orquestração de postagens de vídeos em redes sociais (YouTube Shorts, Instagram Reels, TikTok), com foco em **canais automatizados/dark**, **monetização** e **custo operacional R$ 0,00**.",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "test": "node --test pipeline/test_*.js",
    "test:pipeline": "node --test pipeline/test_*.js",
    "pipeline": "node pipeline/src/run_pipeline.js",
    "deploy:cloudrun": "powershell -ExecutionPolicy Bypass -File scripts/deploy-cloudrun.ps1",
    "deploy:firebase": "powershell -ExecutionPolicy Bypass -File scripts/deploy-firebase.ps1"
  },
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andreyvdecarvalho/auto-publisher.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/andreyvdecarvalho/auto-publisher/issues"
  },
  "homepage": "https://github.com/andreyvdecarvalho/auto-publisher#readme",
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "dotenv": "^17.4.2",
    "playwright": "^1.62.1"
  },
  "dependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@ffprobe-installer/ffprobe": "^2.1.2",
    "fluent-ffmpeg": "^2.1.3",
    "msedge-tts": "^2.0.7",
    "youtube-transcript": "^1.3.1"
  }
}
