# ==============================================================================
# AutoPublisher Pro - Variáveis de Ambiente para Execução Local & Docker
# Copie este arquivo para .env: cp .env.example .env (ou no Windows: copy .env.example .env)
# ==============================================================================

# Porta do Servidor Web
PORT=8080

# ------------------------------------------------------------------------------
# Segurança e Autenticação (Header X-API-KEY)
# ------------------------------------------------------------------------------
# Chave de API do Workspace / Tenant Default (usada nas chamadas do pipeline e cron)
AUTOPUBLISHER_API_KEY=dev-local-api-key

# Master Key para acesso irrestrito ao painel administrativo e gestão de tenants
AUTOPUBLISHER_MASTER_API_KEY=master-super-secret-key

# ------------------------------------------------------------------------------
# Google APIs (Sheets, Drive, YouTube Data API v3)
# ------------------------------------------------------------------------------
# ID da Planilha do Google Sheets (ex: 1BxiMVs0XRA5nFMdKvBdBZjgmUUqptlbs74OgvE2upms)
GOOGLE_SHEETS_SPREADSHEET_ID=

# Nome da aba na planilha (Padrão: Cronograma)
GOOGLE_SHEETS_TAB_NAME=Cronograma

# Credenciais OAuth 2.0 Headless (YouTube / Drive)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# ------------------------------------------------------------------------------
# Redes Sociais Secundárias (Opcional)
# ------------------------------------------------------------------------------
INSTAGRAM_ENABLED=false
INSTAGRAM_BUSINESS_ACCOUNT_ID=
META_ACCESS_TOKEN=

TIKTOK_ENABLED=false
TIKTOK_ACCESS_TOKEN=

# ------------------------------------------------------------------------------
# Pipeline de Inteligência Artificial & Mídia (AI Studio / Auto-Gerador)
# ------------------------------------------------------------------------------
# Chave da API do Google Gemini (Google AI Studio)
GEMINI_API_KEY=
GEMINI_AI_API_KEY=
GOOGLE_AI_API_KEY=

# Chaves de Stock Video (Pexels / Pixabay) para B-Roll vertical
PEXELS_API_KEY=
PIXABAY_API_KEY=
